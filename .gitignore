##########################################
# Byte-code from the checks in .github/   #
##########################################
# Running the checks exactly as AGENTS.md prescribes creates these. Left
# untracked-but-unignored they dirty `git status`, which is the signal used to
# prove a temporary edit was reverted — and a reflexive `git add -A` then
# commits byte-code to a public repo.
__pycache__/
*.py[cod]

###########################################
# Render artefact from .github/scripts/   #
###########################################
# shot.sh copies the page it is about to render to .shot-tmp.html in the repo
# root and removes it on exit. A killed render leaves it behind, and the same
# reasoning as the byte-code above applies: a stray file dirties `git status`,
# which is the signal used to prove a temporary edit was reverted.
.shot-tmp.html

#################################
# Agent harness, machine-local  #
#################################
# Permissions, hooks and MCP servers are a local choice, not a property of the
# project: they carry machine paths and credentials, and pinning them here
# would impose one person's setup on every contributor. The hook SCRIPT is
# tracked (.claude/hooks/) so anyone can point their own settings at it.
.claude/settings.json
.claude/settings.local.json
.mcp.json

# e2e scratch: converted manifests and cluster artefacts from run-e2e.py
tools/nic-migrate/e2e/.work/
